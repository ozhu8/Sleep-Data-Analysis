    # Map Profusion → DYNAM-O stages
    mapping = {
        0: 5,  # Wake
        1: 3,  # N1
        2: 2,  # N2
        3: 1,  # N3
        5: 4   # REM
    }

    # print(stages_df)
    stages_df.iloc[:, 1] = stages_df.iloc[:, 1].map(mapping)
