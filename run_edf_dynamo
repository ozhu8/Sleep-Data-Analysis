    downsample = [5, 1]
    segment_dur = 30
    merge_thresh = 13

    trim_volume = 0.8
    max_merges = np.inf

    stats_table, *_ = run_tfpeaks_soph(
        data,
        fs,
        stages,
        downsample,
        segment_dur,
        merge_thresh,
        max_merges,
        trim_volume,
