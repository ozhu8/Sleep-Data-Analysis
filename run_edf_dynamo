def load_and_prepare_data(edf_path, stages_csv_path):
    print("Loading EEG...")

    raw = mne.io.read_raw_edf(edf_path, preload=True)
    raw.filter(0.1, 35)

    # Pick ONE EEG channel (important!)
    print("Available channels:", raw.ch_names)
    eeg_ch = "EEG"

    raw_eeg = raw.copy().pick([eeg_ch])
    data = raw_eeg.get_data().squeeze()

    fs = raw.info['sfreq']

    print("Loading stages...")

    stages_df = pd.read_csv(stages_csv_path)

    epoch_len = 30
    total_duration = raw.times[-1]

    # Create full epoch timeline
    epoch_times = np.arange(0, total_duration, epoch_len)

